# Copy this file to .env and fill in real values. Never commit .env itself.

ANTHROPIC_API_KEY=

# Shared password required to use the app (the password gate). Give this out
# separately (CV, portfolio site), never commit the real value.
ACCESS_PASSWORD=

# Separate key protecting GET /admin/stats. Keep this different from ACCESS_PASSWORD
# and don't share it publicly.
ADMIN_KEY=
